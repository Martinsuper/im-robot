{
  "name": "im-robot",
  "private": true,
  "version": "1.2.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc && vite build",
    "build:tauri": "tsc && vite build --emptyOutDir false",
    "build:app": "bash scripts/build.sh",
    "build:app:clean": "bash scripts/build.sh --clean",
    "build:app:debug": "bash scripts/build.sh --debug",
    "smoke:install": "node scripts/release-smoke.mjs",
    "test:build": "bash scripts/test-build.sh",
    "test:build:full": "bash scripts/test-build.sh --full",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src --max-warnings 0",
    "agent:prepare": "node scripts/prepare-agent-runtime.mjs",
    "test:calendar": "node scripts/test-calendar-bridge.mjs",
    "test:agent": "node --test agent/*.test.mjs",
    "check:architecture": "node scripts/check-runtime-boundaries.mjs",
    "test:ui": "npm run build && playwright test",
    "test:ui:report": "playwright show-report --host 127.0.0.1",
    "test:notifications-native": "node scripts/test-notification-bridge.mjs",
    "check": "node scripts/check-version.mjs && node scripts/check-runtime-boundaries.mjs && node scripts/check-i18n-keys.mjs && npm run contracts:check",
    "verify": "npm run check && npm run lint && npm test && npm run test:agent && npm run build",
    "smoke:runtime": "node scripts/native-runtime-smoke.mjs",
    "contracts:generate": "cargo run --locked --quiet --manifest-path tools/contracts/Cargo.toml",
    "contracts:check": "cargo run --locked --quiet --manifest-path tools/contracts/Cargo.toml -- --check",
    "test:agent:packaged": "node scripts/test-packaged-agent.mjs",
    "verify:desktop": "node scripts/desktop-acceptance.mjs",
    "inspect:bundle": "node scripts/inspect-macos-bundle.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "katex": "^0.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  },
  "overrides": {
    "katex": "$katex"
  }
}
