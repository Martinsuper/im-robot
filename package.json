{
  "name": "im-robot",
  "private": true,
  "version": "1.2.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc && vite build",
    "build:tauri": "tsc && vite build --emptyOutDir false",
    "build:app": "bash scripts/build.sh",
    "build:app:clean": "bash scripts/build.sh --clean",
    "build:app:debug": "bash scripts/build.sh --debug",
    "smoke:install": "node scripts/release-smoke.mjs",
    "test:build": "bash scripts/test-build.sh",
    "test:build:full": "bash scripts/test-build.sh --full",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "agent:prepare": "node scripts/prepare-agent-runtime.mjs",
    "test:calendar": "node scripts/test-calendar-bridge.mjs",
    "test:agent": "node --test agent/*.test.mjs",
    "check:architecture": "node scripts/check-runtime-boundaries.mjs",
    "test:ui": "npm run build && playwright test",
    "test:ui:report": "playwright show-report --host 127.0.0.1",
    "test:notifications-native": "node scripts/test-notification-bridge.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
