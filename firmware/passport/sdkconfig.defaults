# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# Piko uses a bounded factory partition and reserves the known identity region.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_36=y
# Share ESP-IDF heap with audio and networking; a fixed pool either exhausts
# during rendering or strands memory needed by I2S DMA and WebSocket tasks.
CONFIG_LV_USE_CLIB_MALLOC=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# Wi-Fi and BLE HID pager share the radio.
# 翻页器页：BLE HID 键盘（NimBLE），与 Wi-Fi 共存
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_SW_COEXIST_ENABLE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Main loop snapshot includes bounded Chinese transcript/reply buffers.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_I2S_ISR_IRAM_SAFE=y

# Avoid RX/PING lock contention during continuous audio upload.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=200

# Bound Wi-Fi memory so UI, I2S DMA and the WebSocket task can coexist.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4

# Put optional Wi-Fi acceleration code in flash to reserve RAM for voice.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n

# One HID report map (keyboard and media reports).
CONFIG_BT_NIMBLE_SVC_HID_MAX_INSTANCES=1

# Single HID connection: bounded host/controller buffers and 64-byte ATT MTU.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6

CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8




CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=64

CONFIG_BT_CTRL_BLE_MAX_ACT=2

CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6

CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8

CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
