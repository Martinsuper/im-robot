# Extend a build-local BSP copy with a recoverable full I2S/codec teardown.
# The official sleep API retains DMA; deep-sleep preparation cannot recover.
idf_component_get_property(bsp_target bsp COMPONENT_LIB)
idf_component_get_property(bsp_dir bsp COMPONENT_DIR)
set(audio_source "${bsp_dir}/src/bsp_audio.c")
file(READ "${audio_source}" audio_code)
string(FIND "${audio_code}" "static void audio_cleanup(void)" cleanup_offset)
if(cleanup_offset EQUAL -1)
  message(FATAL_ERROR "BSP audio cleanup changed; review the lifecycle extension")
endif()
string(APPEND audio_code "\n// Piko mode lifecycle: caller has joined all PCM I/O before entering.\nesp_err_t passport_bsp_audio_deinit(void) {\n    if (!s_initialized && !s_rx && !s_tx) return s_codec_release_failed ? ESP_FAIL : ESP_OK;\n    esp_err_t result = bsp_audio_sleep();\n    audio_cleanup();\n    if (s_rx || s_tx || s_codec_release_failed) return ESP_FAIL;\n    return result;\n}\n")
set(patched_audio "${CMAKE_BINARY_DIR}/piko-bsp-patches/bsp_audio.c")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/piko-bsp-patches")
file(CONFIGURE OUTPUT "${patched_audio}" CONTENT "@audio_code@" @ONLY)
get_target_property(bsp_sources ${bsp_target} SOURCES)
list(REMOVE_ITEM bsp_sources "${audio_source}")
list(APPEND bsp_sources "${patched_audio}")
set_property(TARGET ${bsp_target} PROPERTY SOURCES "${bsp_sources}")
target_include_directories(${bsp_target} PRIVATE "${bsp_dir}/src")
