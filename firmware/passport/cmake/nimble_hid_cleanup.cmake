# ESP-IDF 5.5.3 leaves the HID singleton allocated if GATT setup fails.
# Patch a build-local copy; never modify the user's ESP-IDF installation.
if(CONFIG_BT_NIMBLE_ENABLED AND CONFIG_BT_NIMBLE_HID_SERVICE)
  idf_component_get_property(hid_target esp_hid COMPONENT_LIB)
  idf_component_get_property(hid_dir esp_hid COMPONENT_DIR)
  set(hid_source "${hid_dir}/src/nimble_hidd.c")
  file(READ "${hid_source}" hid_code)
  set(old_code "    rc = nimble_hid_start_gatts();\n    if (rc != ESP_OK) {\n        return rc;\n    }")
  set(new_code "    rc = nimble_hid_start_gatts();\n    if (rc != ESP_OK) {\n        ESP_LOGE(TAG, \"HID GATT init failed rc=%d\", rc);\n        nimble_hid_stop_gatts(s_dev);\n        ble_hidd_dev_free();\n        return rc;\n    }")
  string(FIND "${hid_code}" "${old_code}" patch_offset)
  if(patch_offset EQUAL -1)
    message(FATAL_ERROR "NimBLE HID cleanup patch requires review for this ESP-IDF version")
  endif()
  string(REPLACE "${old_code}" "${new_code}" hid_code "${hid_code}")
  set(patched_source "${CMAKE_BINARY_DIR}/piko-idf-patches/nimble_hidd.c")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/piko-idf-patches")
  file(CONFIGURE OUTPUT "${patched_source}" CONTENT "@hid_code@" @ONLY)
  get_target_property(hid_sources ${hid_target} SOURCES)
  list(REMOVE_ITEM hid_sources "${hid_source}")
  list(APPEND hid_sources "${patched_source}")
  set_property(TARGET ${hid_target} PROPERTY SOURCES "${hid_sources}")
endif()
