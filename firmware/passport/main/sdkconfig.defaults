
# 翻页器页：BLE HID 键盘（NimBLE），与 Wi-Fi 共存
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_SW_COEXIST_ENABLE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# One HID report map (keyboard and media reports).
CONFIG_BT_NIMBLE_SVC_HID_MAX_INSTANCES=1

CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6

CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8




CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=64

CONFIG_BT_CTRL_BLE_MAX_ACT=2

CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6

CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8

CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
