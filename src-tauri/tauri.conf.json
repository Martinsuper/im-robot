{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piko",
  "version": "1.2.19",
  "identifier": "com.duanluyao.imrobot",
  "build": {
    "beforeDevCommand": "npm run agent:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run agent:prepare && npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "url": "index.html?view=pet",
        "title": "Piko",
        "width": 260,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "create": false
      },
      {
        "label": "bubble",
        "url": "index.html?view=bubble",
        "title": "Piko Quick Chat",
        "width": 480,
        "height": 420,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 300,
        "decorations": false,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "create": false
      },
      {
        "label": "panel",
        "url": "index.html?view=panel",
        "title": "Piko Assistant",
        "decorations": true,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "skipTaskbar": false,
        "width": 400,
        "height": 700,
        "minWidth": 360,
        "minHeight": 560,
        "alwaysOnTop": false,
        "visible": false,
        "create": false
      },
      {
        "label": "capture",
        "url": "index.html?view=capture",
        "title": "Piko Screenshot",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' preview: http://preview.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/piko-agent-node"
    ],
    "resources": {
      "agent-runtime/": "agent-runtime/"
    }
  }
}
